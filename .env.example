# Google Drive Ayarları
# Davetlilerin form üzerinden fotoğraf yüklediği Google Drive Klasörünün ID'si:
# Örnek Link: https://drive.google.com/drive/folders/1aBcDeFgHiJkLmNoPqRsTuVwXyZ
GOOGLE_DRIVE_FOLDER_ID="BURAYA_DRIVE_KLASOR_ID_GELECEK"

# Service Account json dosya yolu veya OAuth token yolu:
GOOGLE_CREDENTIALS_PATH="backend/credentials/credentials.json"
GOOGLE_TOKEN_PATH="backend/credentials/token.json"

# Sunucu Ayarları
PORT=8000
HOST="0.0.0.0"

# Yüz Tanıma Benzerlik Toleransı (Düşük = Daha katı, Yüksek = Daha esnek eşleşme)
# Cosine distance için genelde 0.40 - 0.50 arası idealdir
FACE_MATCH_THRESHOLD=0.45

# Otomatik Arka Plan Google Drive Tarama Aralığı (Saniye cinsinden - 1800 saniye = 30 dakika)
# 0 yapılırsa otomatik tarama kapanır
AUTO_SYNC_INTERVAL=1800
